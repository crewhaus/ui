# Cloudflare Worker local secrets for the `cf-worker-graph` harness (wrangler `.dev.vars` format).
# Copy this file to `.dev.vars` in THIS folder (gitignored); the host loads it for the worker.
# In production set these with `wrangler secret put <NAME>`.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# The bearer token the worker requires on POST /chat. The host sends it for you, so the
# browser never sees it. Pick a long random value (e.g. `openssl rand -base64 32`).
CHAT_TOKEN=
